# =============================================================================
# TEMPLAT KONFIGURASI LINGKUNGAN (.env.example)
# Salin berkas ini ke '.env' dan sesuaikan kredensial di komputer lokal Anda.
# PENTING: Jangan simpan password sensitif produksi pada berkas ini.
# =============================================================================

APP_NAME="Sistem Pemesanan Restoran"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Konfigurasi Aturan Bisnis
RESERVATION_DEFAULT_DURATION=90

# Konfigurasi Koneksi Basis Data MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restaurant_db
DB_USER=root
DB_PASS=
